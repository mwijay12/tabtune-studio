{
  "name": "tabtune-studio-site",
  "version": "1.2.0",
  "private": true,
  "description": "Marketing site for the TabTune Studio browser extension.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "strict": "node build.mjs --strict",
    "dev": "node build.mjs && node tools/serve.mjs",
